# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.

# PocketBase instance the site reads content from.
# Optional: defaults to https://ksfkitale.pockethost.io when unset.
VITE_PB_URL="https://ksfkitale.pockethost.io"

# Used only by the admin scripts in scripts/ (never bundled into the website,
# since only VITE_-prefixed variables reach the browser).
pockethost_url=https://ksfkitale.pockethost.io
pockethost_admin_email=
pockethost_admin_password=
